{
  "manifest_version": 3,
  "name": "엔트리 링클 - LLNKKR",
  "version": "0.1.16",
  "description": "Less fluff. Pure function.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://llnk.kr/*"
  ],
  "action": {
    "default_title": "엔트리 링클 - LLNKKR",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://playentry.org/*"
      ],
      "js": [
        "src/dark-mode.js"
      ],
      "css": [
        "styles/dark-mode.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://playentry.org/*"
      ],
      "js": [
        "src/entrystory-loader.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://playentry.org/profile/*"
      ],
      "js": [
        "src/common.js",
        "src/profile.js"
      ],
      "css": [
        "styles/base.css",
        "styles/profile.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://playentry.org/ws*"
      ],
      "js": [
        "src/common.js",
        "src/workspace.js"
      ],
      "css": [
        "styles/base.css",
        "styles/workspace.css"
      ],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": [
        "https://playentry.org/community/tips/write*"
      ],
      "js": [
        "src/image-upload-bridge.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/common.js",
        "src/entrystory.js",
        "styles/base.css",
        "styles/entrystory.css",
        "src/thumbnail-runtime.js",
        "src/bloupla-image-frame.html",
        "src/bloupla-image-frame.js",
        "styles/bloupla-image-frame.css",
        "assets/draft-restore/entrybot-spaceship-1.svg"
      ],
      "matches": [
        "https://playentry.org/*"
      ]
    }
  ]
}
